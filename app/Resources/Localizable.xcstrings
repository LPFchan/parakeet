    "Audio access is off. Open System Settings and turn on Parakeet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الصوت متوقف. افتح إعدادات النظام وشغّل Parakeet."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Достъпът до звука е изключен. Отворете Системни настройки и включете Parakeet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístup ke zvuku je vypnutý. Otevřete Nastavení systému a zapněte Parakeet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydadgang er slået fra. Åbn Systemindstillinger, og slå Parakeet til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Audiozugriff ist aus. Öffne die Systemeinstellungen und aktiviere Parakeet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al audio está desactivado. Abre Ajustes del Sistema y activa Parakeet."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Juurdepääs helile on välja lülitatud. Ava Süsteemiseaded ja lülita Parakeet sisse."
          }
        },
        "fi": {
          "stringUnit": {
