          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o Parakeet ouvir o seu Mac"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o Parakeet ouvir o seu Mac"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasă Parakeet să audă Mac-ul tău"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позвольте Parakeet слышать ваш Mac"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechajte Parakeet počúvať váš Mac"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
