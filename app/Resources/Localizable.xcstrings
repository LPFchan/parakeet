    "Preparing for the Neural Engine. This takes about a minute, only the first time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التجهيز لـ Neural Engine. يستغرق ذلك نحو دقيقة في المرة الأولى فقط."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовка за Neural Engine. Отнема около минута, само първия път."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příprava pro Neural Engine. Trvá asi minutu, jen poprvé."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør klar til Neural Engine. Det tager omkring et minut, kun første gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird für die Neural Engine vorbereitet. Das dauert beim ersten Mal etwa eine Minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando para el Neural Engine. Tarda alrededor de un minuto, solo la primera vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmistan ette Neural Engine'i jaoks. See võtab umbes minuti, ainult esimesel korral."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmistellaan Neural Enginelle. Tämä kestää noin minuutin, vain ensimmäisellä kerralla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparation pour le Neural Engine. Cela prend environ une minute, la première fois seulement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neural Engine के लिए तैयार किया जा रहा है। इसमें केवल पहली बार लगभग एक मिनट लगता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Priprema za Neural Engine. Traje otprilike minutu, samo prvi put."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előkészítés a Neural Engine-re. Körülbelül egy percig tart, csak az első alkalommal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparazione per il Neural Engine. Richiede circa un minuto, solo la prima volta."
          }
        },
        "ja": {
