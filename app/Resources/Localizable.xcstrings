          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet이 Mac의 소리를 들을 수 있게 해주세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La Parakeet høre Macen din"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat Parakeet je Mac horen"
          }
        },
        "pl": {
