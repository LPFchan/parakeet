        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet को अपने Mac की आवाज़ सुनने दें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite Parakeetu da čuje vaš Mac"
          }
        },
        "hu": {
