          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet'in Mac'inizi duymasına izin verin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте Parakeet чути ваш Mac"
          }
        },
