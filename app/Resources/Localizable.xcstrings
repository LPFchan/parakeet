    "Captions appear at the bottom of your screen whenever something speaks. Drag the box anywhere you like.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الترجمة النصية أسفل الشاشة كلما تحدّث أحد. اسحب المربع إلى أي مكان تريده."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Субтитрите се появяват в долната част на екрана, когато някой говори. Плъзнете полето където пожелаете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Titulky se zobrazí ve spodní části obrazovky, kdykoli někdo mluví. Rámeček můžete přetáhnout kamkoli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Undertekster vises nederst på skærmen, når der bliver talt. Træk boksen hen, hvor du vil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Untertitel erscheinen unten auf dem Bildschirm, sobald etwas gesprochen wird. Du kannst das Feld beliebig verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los subtítulos aparecen en la parte inferior de la pantalla cuando alguien habla. Arrastra el cuadro donde quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtiitrid ilmuvad ekraani alaossa alati, kui keegi räägib. Lohista kast kuhu soovid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstitys näkyy näytön alareunassa aina, kun jotain puhutaan. Vedä ruutu minne haluat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sous-titres apparaissent en bas de l'écran dès que quelqu'un parle. Faites glisser la zone où vous voulez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब भी कोई बोलता है, कैप्शन आपकी स्क्रीन के नीचे दिखाई देते हैं। बॉक्स को कहीं भी ड्रैग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlovi se pojavljuju na dnu zaslona kad god netko govori. Povucite okvir kamo god želite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A feliratok a képernyő alján jelennek meg, amikor valaki beszél. A dobozt bárhová áthúzhatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I sottotitoli compaiono in fondo allo schermo quando qualcuno parla. Trascina il riquadro dove preferisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何かが話されると、画面の下部に字幕が表示されます。字幕ボックスは好きな場所にドラッグできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말소리가 나오면 화면 아래쪽에 자막이 나타납니다. 자막 상자는 원하는 곳으로 끌어다 놓을 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksting vises nederst på skjermen når noe blir sagt. Dra boksen dit du vil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondertitels verschijnen onder aan je scherm zodra er iets gezegd wordt. Sleep het kader waar je maar wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisy pojawiają się u dołu ekranu, gdy tylko ktoś mówi. Przeciągnij ramkę w dowolne miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As legendas aparecem na parte inferior da tela sempre que alguém fala. Arraste a caixa para onde quiser."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As legendas aparecem na parte inferior do ecrã sempre que alguém fala. Arraste a caixa para onde quiser."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitrările apar în partea de jos a ecranului ori de câte ori vorbește cineva. Trage caseta oriunde vrei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Субтитры появляются внизу экрана, когда кто-то говорит. Перетащите окно куда угодно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Titulky sa zobrazia v spodnej časti obrazovky vždy, keď niekto hovorí. Rámček môžete presunúť kamkoľvek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Undertexter visas längst ned på skärmen så fort något sägs. Dra rutan vart du vill."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biri konuştuğunda altyazılar ekranın altında görünür. Kutuyu istediğiniz yere sürükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Субтитри з'являються внизу екрана, щойно хтось говорить. Перетягніть поле куди завгодно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phụ đề xuất hiện ở cuối màn hình mỗi khi có người nói. Bạn có thể kéo khung đến bất kỳ đâu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每当有人说话，字幕就会出现在屏幕底部。你可以把字幕框拖到任何位置。"
          }
        }
      }
    },
    "Parakeet lives in the menu bar. Click it to turn captions off (⌘L) or copy the transcript.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد Parakeet في شريط القائمة. انقر عليه لإيقاف الترجمة النصية (⌘L) أو نسخ النص المفرّغ."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet се намира в лентата с менюта. Щракнете върху него, за да изключите субтитрите (⌘L) или да копирате транскрипцията."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet najdete na řádku nabídek. Klikněte na něj a můžete vypnout titulky (⌘L) nebo zkopírovat přepis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet findes på menulinjen. Klik på den for at slå undertekster fra (⌘L) eller kopiere transskriptionen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet befindet sich in der Menüleiste. Klicke darauf, um Untertitel auszuschalten (⌘L) oder das Transkript zu kopieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet está en la barra de menús. Haz clic para desactivar los subtítulos (⌘L) o copiar la transcripción."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet asub menüüribal. Klõpsa sellel, et subtiitrid välja lülitada (⌘L) või transkriptsioon kopeerida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet on valikkorivillä. Klikkaa sitä laittaaksesi tekstityksen pois (⌘L) tai kopioidaksesi litteroinnin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet se trouve dans la barre des menus. Cliquez dessus pour désactiver les sous-titres (⌘L) ou copier la transcription."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet मेनू बार में रहता है। कैप्शन बंद करने (⌘L) या ट्रांसक्रिप्ट कॉपी करने के लिए उस पर क्लिक करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet se nalazi na traci s izbornicima. Kliknite ga da biste isključili titlove (⌘L) ili kopirali transkript."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Parakeet a menüsorban található. Kattints rá a feliratok kikapcsolásához (⌘L) vagy az átirat másolásához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet si trova nella barra dei menu. Fai clic per disattivare i sottotitoli (⌘L) o copiare la trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeetはメニューバーにあります。クリックすると字幕をオフにしたり（⌘L）、書き起こしをコピーしたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet은 메뉴 막대에 있습니다. 클릭해서 자막을 끄거나(⌘L) 대본을 복사할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet ligger i menylinjen. Klikk på den for å slå av teksting (⌘L) eller kopiere transkripsjonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet staat in de menubalk. Klik erop om ondertiteling uit te zetten (⌘L) of het transcript te kopiëren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet znajduje się na pasku menu. Kliknij go, aby wyłączyć napisy (⌘L) lub skopiować transkrypcję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Parakeet fica na barra de menus. Clique nele para desativar as legendas (⌘L) ou copiar a transcrição."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Parakeet está na barra de menus. Clique nele para desativar as legendas (⌘L) ou copiar a transcrição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet se află în bara de meniu. Fă clic pe el pentru a dezactiva subtitrările (⌘L) sau pentru a copia transcrierea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet находится в строке меню. Нажмите на него, чтобы выключить субтитры (⌘L) или скопировать расшифровку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet nájdete na lište ponuky. Kliknutím naň môžete vypnúť titulky (⌘L) alebo skopírovať prepis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet finns i menyraden. Klicka på den för att stänga av undertexter (⌘L) eller kopiera transkriptionen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet menü çubuğunda bulunur. Altyazıları kapatmak (⌘L) veya dökümü kopyalamak için tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet розташований у смузі меню. Клацніть його, щоб вимкнути субтитри (⌘L) або скопіювати розшифровку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet nằm trên thanh menu. Bấm vào để tắt phụ đề (⌘L) hoặc sao chép bản ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet 位于菜单栏中。点按它即可关闭字幕（⌘L）或拷贝文字记录。"
          }
        }
      }
    },
