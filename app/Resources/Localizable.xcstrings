    "Live captions for everything your Mac plays.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمة نصية مباشرة لكل ما يشغّله جهاز Mac."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Субтитри на живо за всичко, което възпроизвежда вашият Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Živé titulky ke všemu, co váš Mac přehrává."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-undertekster til alt, hvad din Mac afspiller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Untertitel für alles, was dein Mac abspielt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtítulos en directo para todo lo que suena en tu Mac."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsesubtiitrid kõigele, mida su Mac esitab."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaaliaikainen tekstitys kaikelle, mitä Macisi toistaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des sous-titres en direct pour tout ce que joue votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Mac पर चलने वाली हर चीज़ के लिए लाइव कैप्शन।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlovi uživo za sve što vaš Mac reproducira."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Élő feliratok mindenhez, amit a Maced lejátszik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sottotitoli in tempo reale per tutto ciò che riproduce il tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macで再生されるすべての音声に、リアルタイム字幕を。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 재생되는 모든 소리에 실시간 자막을."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkteteksting av alt Macen din spiller av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Live ondertiteling voor alles wat je Mac afspeelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisy na żywo do wszystkiego, co odtwarza Twój Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Legendas ao vivo para tudo que o seu Mac reproduz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Legendas em direto para tudo o que o Mac reproduz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitrări live pentru tot ce redă Mac-ul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Субтитры в реальном времени для всего, что воспроизводит ваш Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Živé titulky ku všetkému, čo prehráva váš Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkttextning av allt som spelas upp på din Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizde çalan her şey için canlı altyazılar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Субтитри наживо для всього, що відтворює ваш Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phụ đề trực tiếp cho mọi thứ máy Mac của bạn phát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Mac 播放的一切内容提供实时字幕。"
          }
        }
      }
    },
    "Runs on your Mac. Audio never leaves it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل على جهاز Mac. لا يغادره الصوت أبدًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Работи на вашия Mac. Звукът никога не го напуска."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běží na vašem Macu. Zvuk ho nikdy neopustí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kører på din Mac. Lyden forlader den aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft auf deinem Mac. Audio verlässt ihn nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona en tu Mac. El audio nunca sale de él."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Töötab su Macis. Heli ei lahku sealt kunagi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toimii Macillasi. Ääni ei koskaan poistu siitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne sur votre Mac. L'audio ne le quitte jamais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Mac पर ही चलता है। ऑडियो कभी बाहर नहीं जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radi na vašem Macu. Zvuk ga nikad ne napušta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Maceden fut. A hang soha nem hagyja el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona sul tuo Mac. L'audio non lo lascia mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理はすべてMac上で行われ、音声が外部に送られることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 처리는 Mac에서 이루어지며, 오디오는 외부로 나가지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjører på Macen din. Lyden forlater den aldri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkt op je Mac. Audio verlaat hem nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa na Twoim Macu. Dźwięk nigdy go nie opuszcza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona no seu Mac. O áudio nunca sai dele."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona no seu Mac. O áudio nunca sai dele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulează pe Mac-ul tău. Sunetul nu îl părăsește niciodată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает на вашем Mac. Звук никогда не покидает его."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Beží na vašom Macu. Zvuk ho nikdy neopustí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Körs på din Mac. Ljudet lämnar den aldrig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizde çalışır. Ses asla dışarı çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Працює на вашому Mac. Звук ніколи його не покидає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy trên máy Mac của bạn. Âm thanh không bao giờ rời khỏi máy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全在你的 Mac 上运行，音频绝不会离开它。"
          }
        }
      }
    },
    "Let Parakeet hear your Mac": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ Parakeet بسماع جهاز Mac"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволете на Parakeet да чува вашия Mac"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechte Parakeet poslouchat váš Mac"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad Parakeet høre din Mac"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass Parakeet deinen Mac hören"
          }
        },
        "es": {
